<div class="page-island kitchens-index">
  <div class="kitchens-index__hero">
    <h1 class="kitchens-index__title">Shared Kitchen Reservations</h1>
    <p class="kitchens-index__subtitle">
      Select a kitchen below to view availability and book your cooking time.
    </p>
  </div>

  <h2 class="kitchens-index__section-heading">Available Kitchens</h2>
  <ul class="kitchens-index__list">
    <% @kitchens.each do |kitchen| %>
      <li class="kitchens-index__item">
        <div class="kitchens-index__item-info">
          <span class="kitchens-index__item-name"><%= kitchen.name %></span>
          <span class="kitchens-index__item-meta"><%= kitchen.location %> &middot; capacity <%= kitchen.capacity %></span>
        </div>
        <%= link_to "View & Book", kitchen_path(kitchen), class: "kitchens-index__item-link" %>
      </li>
    <% end %>
  </ul>
</div>
