<div style="background-color: #e9ecef; padding: 30px; border-radius: 10px; text-align: center; margin-bottom: 30px;">
  <h1 style="margin: 0; color: #2c3e50;">🧑‍🍳 Shared Kitchen Reservations</h1>
  <p style="color: #555; font-size: 1.2rem; margin-top: 10px;">
    Select a kitchen below to view availability and book your cooking time.
  </p>
</div>

<h2>Available Kitchens</h2>
<ul>
  <% @kitchens.each do |kitchen| %>
    <li style="margin-bottom: 15px;">
      <strong><%= kitchen.name %></strong> (Location: <%= kitchen.location %>) 
      <br>
      <%= link_to "View & Book this Kitchen", kitchen_path(kitchen) %>
    </li>
  <% end %>
</ul>