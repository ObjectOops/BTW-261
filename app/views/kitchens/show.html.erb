<%= link_to "← Back to all kitchens", root_path %>

<h2><%= @kitchen.name %></h2>
<p><strong>Location:</strong> <%= @kitchen.location %></p>
<p><strong>Capacity:</strong> <%= @kitchen.capacity %> people</p>

<hr>

<h3>Book this Kitchen</h3>
<%= form_with(url: kitchen_reservations_path(@kitchen), local: true) do |form| %>
  <div>
    <%= form.label :netid, "Your NetID:" %>
    <%= form.text_field :netid, required: true %>
  </div>
  <br>
  
  <div>
    <%= form.label :reservation_date, "Date:" %>
    <%= form.date_field :reservation_date, required: true, min: Date.today %>
  </div>
  <br>

  <div>
    <%= form.label :start_hour, "Start Time:" %>
    <%= form.select :start_hour, [
      ['8:00 AM', 8], ['9:00 AM', 9], ['10:00 AM', 10], ['11:00 AM', 11],
      ['12:00 PM', 12], ['1:00 PM', 13], ['2:00 PM', 14], ['3:00 PM', 15],
      ['4:00 PM', 16], ['5:00 PM', 17], ['6:00 PM', 18], ['7:00 PM', 19],
      ['8:00 PM', 20], ['9:00 PM', 21]
    ] %>
  </div>
  <br>

  <div>
    <%= form.label :duration, "Duration:" %>
    <%= form.select :duration, [["1 Hour", 1], ["2 Hours", 2]] %>
  </div>
  <br>

  <%= form.submit "Confirm Reservation" %>
<% end %>

<hr>

<h3>Current Reservations</h3>
<ul>
  <% @reservations.each do |reservation| %>
    <% if reservation.persisted? %>
      <li style="margin-bottom: 10px;">
        <strong><%= reservation.netid %></strong> has booked this from: <br>
        <%= reservation.start_time.strftime("%B %d at %I:%M %p") %> to <%= reservation.end_time.strftime("%I:%M %p") %>
        
        <%= button_to "Cancel Booking", kitchen_reservation_path(@kitchen, reservation), method: :delete, data: { turbo_confirm: "Are you sure you want to cancel this booking?" }, style: "color: red; margin-top: 5px;" %>
      </li>
    <% end %>
  <% end %>
</ul>